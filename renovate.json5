{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests", // to pin digests of docker images
    ":dependencyDashboard"
  ],

  // Don't limit PRs: useful to get all updates asap + to avoid issues
  // if the bot state doesn't match github state (branch deleted by hand etc.)
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,

  // Automerge
  "automerge": true,
  "automergeType": "branch",

  // Packages ruiles
  "packageRules": [
    // Python images are already per minor release,
    // don't attempt to upgrade them
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "python", // For the images using base official python as source
        "ghcr.io/corenting/base-container-images/python" // For the images inheriting from our base python image
      ],
      "matchUpdateTypes": ["major","minor"],
      "enabled": false
    },
    // Debian images are per major release, so block major
    // upgrade
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "debian" // We only use official debian as base image
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],

  // For updates of debian packages in Dockerfiles
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "**/Dockerfile"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s+depName=(?<depName>\\S+)\\nARG \\w+=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "deb",
      "registryUrlTemplate": "https://deb.debian.org/debian?suite=trixie&components=main&binaryArch=amd64",
      "versioningTemplate": "deb"
    }
  ]
}
